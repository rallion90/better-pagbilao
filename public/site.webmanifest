{
  "name": "Better Pagbilao",
  "short_name": "BetterPagbilao",
  "description": "Community-built portal for Pagbilao, Quezon — government services, emergency hotlines, tourism spots, barangay info, and public documents in one place.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#172033",
  "lang": "en-PH",
